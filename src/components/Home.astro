---
import Card from './Card.astro';
import HeroSlides from './HeroSlides.astro';
import { routes, t } from '../lib/i18n.js';
import { experiences, mediaById, heroSlides } from '../lib/pocketbase.js';
const { lang = 'el' } = Astro.props;
const L = t[lang];
const R = routes[lang];
const { current, archive } = await experiences(lang);
// Finished exhibitions marked «Προτεινόμενη» in Work also stay on the home page (after the current ones, labelled ΟΛΟΚΛΗΡΩΘΗΚΕ).
const homeItems = [...current, ...archive.filter((p) => p.featured)];
// Hero: slides chosen in Work → «Hero αρχικής» (Panorama); otherwise current hero images, else the venue photo.
const facade = await mediaById('h7tjyr00agl3133');
const slides = await heroSlides(lang, current, R.detail, facade);
---
<main>
  <section class="hero">
    <HeroSlides slides={slides} labels={L.status} lang={lang}/>
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <h1>{L.heroTitle}</h1>
      <p class="hero-lead">{L.heroLead}</p>
      <div class="actions"><a class="btn btn-light" href={R.list}>{L.heroCta1}</a><a class="btn btn-line" href={R.schools}>{L.heroCta2}</a></div>
      <HeroSlides slides={slides} labels={L.status} lang={lang} part="captions"/>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>{L.currentTitle}</h2><a class="text-link" href={R.list}>{L.allLink} →</a></div>
    {homeItems.length ? <div class="cards-large">{homeItems.map((p) => <Card p={p} lang={lang}/>)}</div> : <p class="empty">{L.empty}</p>}
  </section>

  <section class="section space-section">
    <div class="wrap space-grid">
      <div class="space-copy">
        <h2>{L.spaceTitle}</h2>
        <p>{L.spaceText}</p>
      </div>
      {facade && <img class="space-photo" src={facade} alt="Panorama Digital Theatre" loading="lazy"/>}
    </div>
    <div class="wrap tech-grid">{L.tech.map(([h, d]) => <div class="tech"><h3>{h}</h3><p>{d}</p></div>)}</div>
  </section>

  <section class="schools-band">
    <div class="wrap schools-inner">
      <div><h2>{L.schoolsTitle}</h2><p>{L.schoolsText}</p></div>
      <a class="btn btn-accent" href={R.schools}>{L.schoolsCta}</a>
    </div>
  </section>
</main>
