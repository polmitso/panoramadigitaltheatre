---
import { t } from '../lib/i18n.js';
import { venueInfo } from '../lib/pocketbase.js';
const { lang = 'el' } = Astro.props;
const L = t[lang];
const v = await venueInfo();
const G = L.getThere;
const DIRECTIONS = 'https://maps.app.goo.gl/meRxARRLeugMiemG7';
const INFO_PHONE = '2313 255888';
const q = encodeURIComponent(`${v.address || 'Λεωφόρος Μίκη Θεοδωράκη 15'}, Θεσσαλονίκη`);
---
<main class="wrap page">
  <header class="page-head"><h1>{L.contactTitle}</h1><p class="lead">{L.contactLead}</p></header>
  <div class="contact">
    <dl class="contact-list">
      {v.address && <div><dt>{L.address}</dt><dd>{v.address}<br/>Θεσσαλονίκη<br/><a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${q}`} target="_blank" rel="noopener">{L.map} ↗</a></dd></div>}
      {v.phone && <div><dt>{L.phone}</dt><dd><a href={'tel:' + v.phone.replace(/\s/g, '')}>{v.phone}</a></dd></div>}
      {v.email && <div><dt>{L.email}</dt><dd><a href={'mailto:' + v.email}>{v.email}</a></dd></div>}
      <p class="note">{L.ticketsNote}</p>
    </dl>
    <div class="map"><iframe title="Map" src={`https://www.google.com/maps?q=${q}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>

  <section class="getthere" aria-labelledby="gt-title">
    <h2 id="gt-title">{G.title}</h2>
    <p class="gt-lead">{G.lead}</p>
    <div class="gt-grid">
      <article class="gt-card">
        <svg class="gt-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 11h14M9 21l1.5-4M15 21l-1.5-4"/><circle cx="9" cy="14" r=".6"/><circle cx="15" cy="14" r=".6"/></svg>
        <h3>{G.metro.title}</h3>
        <p>{G.metro.text}</p>
        <p class="gt-time">{G.metro.time}</p>
      </article>
      <article class="gt-card">
        <svg class="gt-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="15" rx="3"/><path d="M4 10h16M8 21v-3M16 21v-3"/><circle cx="8" cy="14" r=".6"/><circle cx="16" cy="14" r=".6"/></svg>
        <h3>{G.bus.title}</h3>
        <p>{G.bus.text}</p>
        {G.bus.groups.map(([where, lines]) => <div class="gt-lines"><span>{where}</span><ul>{lines.map((l) => <li>{l}</li>)}</ul></div>)}
        <p class="gt-time">{G.bus.time}</p>
        <p class="gt-note">{G.bus.note}</p>
        <a class="text-link" href="https://oasth.gr" target="_blank" rel="noopener">{G.bus.link} ↗</a>
      </article>
      <article class="gt-card">
        <svg class="gt-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 16l1.5-5a2 2 0 0 1 1.9-1.4h7.2a2 2 0 0 1 1.9 1.4L19 16"/><rect x="3.5" y="15" width="17" height="4" rx="1.5"/><path d="M6.5 19v2M17.5 19v2"/></svg>
        <h3>{G.car.title}</h3>
        <p>{G.car.text}</p>
        <a class="btn btn-light gt-btn" href={DIRECTIONS} target="_blank" rel="noopener">{G.car.link} ↗</a>
      </article>
    </div>
    <p class="gt-info">{G.info}: <a href={'tel:+30' + INFO_PHONE.replace(/\s/g, '')}>{INFO_PHONE}</a></p>
  </section>
</main>
