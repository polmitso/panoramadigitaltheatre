---
import { t } from '../lib/i18n.js';
const { lang = 'el' } = Astro.props;
const L = t[lang];
const G = L.getThere;
const DIRECTIONS = 'https://maps.app.goo.gl/meRxARRLeugMiemG7';
const INFO_PHONE = '2313 255888';
---
<main class="wrap page">
  <header class="page-head"><h1>{G.title}</h1><p class="lead">{G.lead}</p></header>
  <section class="getthere">
    <div class="gt-layout">
      <article class="gt-card gt-bus">
        <svg class="gt-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="15" rx="3"/><path d="M4 10h16M8 21v-3M16 21v-3"/><circle cx="8" cy="14" r=".6"/><circle cx="16" cy="14" r=".6"/></svg>
        <h3>{G.bus.title}</h3>
        <p class="gt-stop">{G.bus.text}</p>
        {G.bus.groups.map((g) => (
          <div class="gt-group">
            <h4>{g.title}</h4>
            <ul class="gt-routes">{g.items.map(([lines, text]) => <li><span class="gt-chips">{lines.map((l) => <b>{l}</b>)}</span><span>{text}</span></li>)}</ul>
          </div>
        ))}
        <p class="gt-walk">{G.bus.walk}</p>
        <a class="text-link" href="https://oasth.gr" target="_blank" rel="noopener">{G.bus.link} ↗</a>
      </article>
      <div class="gt-side">
      <article class="gt-card">
        <svg class="gt-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 11h14M9 21l1.5-4M15 21l-1.5-4"/><circle cx="9" cy="14" r=".6"/><circle cx="15" cy="14" r=".6"/></svg>
        <h3>{G.metro.title}</h3>
        <p>{G.metro.text}</p>
        <p class="gt-time">{G.metro.time}</p>
      </article>
      <article class="gt-card">
        <svg class="gt-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 16l1.5-5a2 2 0 0 1 1.9-1.4h7.2a2 2 0 0 1 1.9 1.4L19 16"/><rect x="3.5" y="15" width="17" height="4" rx="1.5"/><path d="M6.5 19v2M17.5 19v2"/></svg>
        <h3>{G.car.title}</h3>
        <p>{G.car.text}</p>
        <a class="btn btn-light gt-btn" href={DIRECTIONS} target="_blank" rel="noopener">{G.car.link} ↗</a>
      </article>
      </div>
    </div>
    <p class="gt-info">{G.info}: <a href={'tel:+30' + INFO_PHONE.replace(/\s/g, '')}>{INFO_PHONE}</a></p>
  </section>
</main>
