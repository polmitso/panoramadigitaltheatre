---
import Card from './Card.astro';
import { t } from '../lib/i18n.js';
import { experiences } from '../lib/pocketbase.js';
const { lang = 'el' } = Astro.props;
const L = t[lang];
const { current, archive } = await experiences(lang);
---
<main class="wrap page">
  <header class="page-head"><h1>{L.listTitle}</h1><p class="lead">{L.listLead}</p></header>
  <section class="block">
    {current.length + archive.length ? <div class="cards-large">{[...current, ...archive].map((p) => <Card p={p} lang={lang}/>)}</div> : <p class="empty">{L.empty}</p>}
  </section>
</main>
