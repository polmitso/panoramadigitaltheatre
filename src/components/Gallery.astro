---
// Production photo gallery (from the production's "gallery" field in Work) with a simple lightbox.
// images: [{ src, alt }] — src is the full file URL; thumbnails use PocketBase ?thumb.
const { images = [], lang = 'el', title } = Astro.props;
const en = lang === 'en';
const T = en ? { title: 'Photos', close: 'Close', prev: 'Previous photo', next: 'Next photo' } : { title: 'Φωτογραφίες', close: 'Κλείσιμο', prev: 'Προηγούμενη φωτογραφία', next: 'Επόμενη φωτογραφία' };
---
{images.length > 0 && (
  <section class="gal" aria-label={title || T.title}>
    <h2>{title || T.title}</h2>
    <div class="gal-grid">
      {images.map((im, i) => <button type="button" class="gal-item" data-gal={i} aria-label={`${T.title} ${i + 1}`}><img src={im.src + '?thumb=800x0'} alt={im.alt || ''} loading="lazy"/></button>)}
    </div>
    <dialog class="gal-box" aria-label={title || T.title}>
      <img class="gal-full" alt=""/>
      <button type="button" class="gal-btn gal-close" aria-label={T.close}>×</button>
      {images.length > 1 && <button type="button" class="gal-btn gal-prev" aria-label={T.prev}>‹</button>}
      {images.length > 1 && <button type="button" class="gal-btn gal-next" aria-label={T.next}>›</button>}
      <span class="gal-count"></span>
    </dialog>
    <script is:inline define:vars={{ srcs: images.map((im) => im.src) }}>
      (() => {
        const root = document.currentScript.closest('.gal'), box = root.querySelector('.gal-box'), img = box.querySelector('.gal-full'), count = box.querySelector('.gal-count');
        let i = 0;
        const show = (n) => { i = (n + srcs.length) % srcs.length; img.src = srcs[i]; count.textContent = srcs.length > 1 ? `${i + 1} / ${srcs.length}` : ''; };
        root.querySelectorAll('[data-gal]').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.gal)); box.showModal(); }));
        box.querySelector('.gal-close').addEventListener('click', () => box.close());
        box.querySelector('.gal-prev')?.addEventListener('click', () => show(i - 1));
        box.querySelector('.gal-next')?.addEventListener('click', () => show(i + 1));
        box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
        box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
        let x0 = null;
        box.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
        box.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); x0 = null; });
      })();
    </script>
  </section>
)}
