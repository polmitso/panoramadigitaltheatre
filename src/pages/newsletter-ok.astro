---
import Site from '../layouts/Site.astro';
---
<Site lang="el" title="Newsletter">
  <main class="wrap" style="padding:120px 0 80px;min-height:50vh">
    <h1 style="margin:0 0 16px;font-size:clamp(32px,5vw,52px)">Ευχαριστούμε!</h1>
    <p style="margin:0 0 28px;font-size:18px;line-height:1.6;opacity:.8;max-width:560px">Η εγγραφή σου στο newsletter επιβεβαιώθηκε. Θα τα λέμε στα εισερχόμενά σου.</p>
    <a href="/" style="color:inherit;text-decoration:underline">Στην αρχική →</a>
  </main>
</Site>
