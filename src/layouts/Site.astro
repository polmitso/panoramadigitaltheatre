---
import { routes, pairs, t } from '../lib/i18n.js';
import { mediaById, venueInfo } from '../lib/pocketbase.js';
const { lang = 'el', title = '' } = Astro.props;
const L = t[lang];
const R = routes[lang];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pair = pairs.find((p) => p.some((x) => path === x || path.startsWith(x + '/') && x !== '/' && x !== '/en')) || pairs[0];
const [logo, venue] = await Promise.all([mediaById('0ozzt1y92y1e6na'), venueInfo()]);
const nav = [[R.list, L.nav.list], [R.schools, L.nav.schools], [R.contact, L.nav.contact]];
const desc = lang === 'en'
  ? 'Panorama Digital Theatre, Thessaloniki — culture, art and technology in one place: exhibitions, shows, events and school visits.'
  : 'Panorama Digital Theatre, Θεσσαλονίκη — πολιτισμός, τέχνη και τεχνολογία σε έναν χώρο: εκθέσεις, θεάματα, εκδηλώσεις και επισκέψεις σχολείων.';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title ? `${title} | Panorama Digital Theatre` : 'Panorama Digital Theatre'}</title>
<meta name="description" content={desc}/>
<link rel="icon" type="image/png" href="/favicon.png"/>
<link rel="apple-touch-icon" href="/favicon.png"/>
<link rel="alternate" hreflang="el" href={pair[0]}/>
<link rel="alternate" hreflang="en" href={pair[1]}/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&family=Manrope:wght@300;400;500;600&display=swap"/>
<link rel="stylesheet" href="/style.css"/>
<script is:inline defer src="https://stats.videotheatre.gr/script.js" data-website-id="b562bc20-4fff-4b70-aa5b-19f41114c620" data-domains="panorama.com.gr,www.panorama.com.gr"></script><script is:inline>/* Umami: μέτρηση κλικ (εισιτήρια, email, τηλέφωνο, εξωτερικοί σύνδεσμοι, φόρμα) */document.addEventListener("click",function(e){var a=e.target.closest&&e.target.closest("a[href]");if(!a||!window.umami)return;var h=a.href,t=(a.textContent||"").trim(),n;if(/more\.com|viva\.gr|ticketservices|eventora/i.test(h)||/εισιτ|ticket/i.test(t))n="Εισιτήρια";else if(h.indexOf("mailto:")==0)n="Email";else if(h.indexOf("tel:")==0)n="Τηλέφωνο";else if(a.hostname&&a.hostname!=location.hostname)n="Εξωτερικός σύνδεσμος";if(n)window.umami.track(n,{link:h.replace(/^mailto:|\?.*$/g,""),page:location.pathname,text:t.slice(0,60)})},true);document.addEventListener("submit",function(e){if(window.umami&&e.target.matches&&e.target.matches(".contact-form"))window.umami.track("Φόρμα επικοινωνίας",{page:location.pathname})},true);</script></head>
<body>
<header class="site-header">
  <nav class="wrap" aria-label={lang === 'en' ? 'Main navigation' : 'Κύρια πλοήγηση'}>
    <a class="brand" href={R.home}>{logo ? <img src={logo} alt="Panorama Digital Theatre"/> : <span>PANORAMA</span>}</a>
    <div class="nav-links">{nav.map(([href, label]) => <a href={href} class:list={{ active: path === href || path.startsWith(href + '/') }}>{label}</a>)}</div>
    <div class="languages"><a href={pair[0]} aria-current={lang === 'el' ? 'page' : undefined}>EL</a><span aria-hidden="true">/</span><a href={pair[1]} aria-current={lang === 'en' ? 'page' : undefined}>EN</a></div>
  </nav>
</header>
<slot/>
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">{logo && <img src={logo} alt="Panorama Digital Theatre"/>}<a href="https://videotheatre.gr" target="_blank" rel="noopener">{L.footerNote} ↗</a></div>
    <div class="footer-col">{venue.address && <span>{venue.address}, Θεσσαλονίκη</span>}{venue.phone && <a href={'tel:' + venue.phone.replace(/\s/g, '')}>{venue.phone}</a>}{venue.email && <a href={'mailto:' + venue.email}>{venue.email}</a>}</div>
    <div class="footer-col"><a href={R.list}>{L.nav.list}</a><a href={R.schools}>{L.nav.schools}</a><a href={R.contact}>{L.nav.contact}</a></div>
  </div>
</footer>
</body>
</html>
